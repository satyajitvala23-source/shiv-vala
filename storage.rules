rules_version = '2';

// Firebase Cloud Storage security rules for Shiv Computer
// Strict Role-Based Security: Only Admin can upload, edit, and delete documents.
// Users can only view, preview, and download documents uploaded by the Admin.
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['satyajitvala23@gmail.com', 'admin@shivcomputer.com', 'satu@shivcomputer.com'] ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // Official Published Documents (Managed exclusively by Admin)
    match /documents/{allPaths=**} {
      // Anyone / All Users can view and download official documents
      allow read: if true;

      // ONLY verified Admin can upload, edit, or delete documents
      allow write: if isAdmin() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Fallback path
    match /{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
  }
}
