rules_version = '2';

// Firebase Cloud Storage security rules for Shiv Computer
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['satyajitvala23@gmail.com', 'admin@shivcomputer.com', 'satu@shivcomputer.com'] ||
        request.auth.token.role == 'admin'
      );
    }

    // Official Published Documents (Public Library)
    match /documents/{allPaths=**} {
      // Anyone can download or view published official forms & documents
      allow read: if true;

      // Only authenticated admins can upload, edit, or delete up to 25 MB
      allow write: if isAdmin() &&
        request.resource.size < 25 * 1024 * 1024;
    }

    // Citizen Personal Locker Documents
    match /user_documents/{allPaths=**} {
      // User can view their own documents; Admin can view all
      allow read: if isAuthenticated();

      // Authenticated users and admins can upload and manage documents up to 25 MB
      allow write: if isAuthenticated() &&
        request.resource.size < 25 * 1024 * 1024;
    }

    // Applicant Submitted Application Proofs (Aadhaar, 7/12, Ration Cards, Photos)
    match /applicant_docs/{userId}/{allPaths=**} {
      // User can view their own documents; Admin can view all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // User can upload their own verification documents (up to 25 MB)
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) &&
        request.resource.size < 25 * 1024 * 1024;
    }
  }
}
